<RCC>
    <qresource prefix="/music">
        <file>qml/MainScreen.qml</file>
        <file>qml/HeaderBar.qml</file>
        <file>qml/AlbumArt.qml</file>
        <file>qml/PlayerControls.qml</file>
        <file>qml/VolumeBar.qml</file>
        <file>qml/StatusBar.qml</file>
        <file>qml/PlaylistPanel.qml</file>
        <file>qml/ErrorBanner.qml</file>
        <file>qml/Utils.js</file>
        <file>qml/Theme.js</file>
        <file alias="icons/play.svg">resources/play.svg</file>
        <file alias="icons/pause.svg">resources/pause.svg</file>
        <file alias="icons/stop.svg">resources/stop.svg</file>
        <file alias="icons/next.svg">resources/next.svg</file>
        <file alias="icons/previous.svg">resources/previous.svg</file>
        <file alias="icons/volume_up.svg">resources/volume_up.svg</file>
        <file alias="icons/volume_down.svg">resources/volume_down.svg</file>
        <file alias="icons/music_note.svg">resources/music_note.svg</file>
        <file alias="icons/folder_open.png">resources/folder_open.png</file>
        <file alias="icons/play_circle.svg">resources/play_circle.svg</file>
        <file alias="icons/pause_circle.svg">resources/pause_circle.svg</file>
        <file alias="icons/skip_previous.svg">resources/skip_previous.svg</file>
        <file alias="icons/skip_next.svg">resources/skip_next.svg</file>
        <file alias="icons/volume_low.svg">resources/volume_low.svg</file>
        <file alias="icons/volume_high.svg">resources/volume_high.svg</file>
    </qresource>
</RCC>