# ── Luckfox Shell — Environment Variables ──────────────────────
# Copy to ".env" and fill in, then `source .env` before building.

# Path to the cross-toolchain qmake binary (from Luckfox buildroot)
export LUCKFOX_QMAKE=/path/to/buildroot/output/host/bin/qmake

# SSH key for deploy + run (PRIVATE KEY — keep this secret, never commit it)
export LUCKFOX_SSH_KEY=/home/youruser/.ssh/id_ed25519

# Board target
export LUCKFOX_BOARD_IP=192.168.1.3
export LUCKFOX_BOARD_USER=root
