####### Install

install_target: first FORCE
	@test -d $(INSTALL_ROOT)/root || mkdir -p $(INSTALL_ROOT)/root
	$(QINSTALL_PROGRAM) $(QMAKE_TARGET) $(INSTALL_ROOT)/root/$(QMAKE_TARGET)

uninstall_target: FORCE
	-$(DEL_FILE) $(INSTALL_ROOT)/root/$(QMAKE_TARGET)
	-$(DEL_DIR) $(INSTALL_ROOT)/root/ 


install: install_target  FORCE

uninstall: uninstall_target  FORCE

FORCE:

