	@test -d $(DISTDIR) || mkdir -p $(DISTDIR)
	$(COPY_FILE) --parents $(DIST) $(DISTDIR)/
	$(COPY_FILE) --parents qml/shell.qrc modules/photoframe/photoframe.qrc modules/voicetest/voicetest.qrc modules/calendar/calendar.qrc modules/wifi/wifi.qrc modules/dashboard/dashboard.qrc modules/music/music.qrc $(DISTDIR)/
